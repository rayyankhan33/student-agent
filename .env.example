# Copy to .env for local runs. Never commit real keys.
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO

MODEL_PROVIDER=gemini
MODEL_NAME=gemini-3.1-flash-lite
AVAILABLE_MODELS=gemini-3.5-flash-lite,gemini-2.5-flash
GEMINI_API_KEY=

# Budgets (server-side ceilings)
MAX_STEPS=6
MAX_TOOL_RETRIES=2
MAX_REPAIR_ATTEMPTS=2
MAX_OUTPUT_TOKENS=768
MAX_RUN_TOKENS=40000
RUN_TIMEOUT_SECONDS=40
LLM_TIMEOUT_SECONDS=15
TOOL_TIMEOUT_SECONDS=2.5

# Conversation memory
MAX_HISTORY_MESSAGES=12
MAX_HISTORY_CHARS=12000
MAX_SESSIONS=100

# Approximate USD per 1M tokens (input/output), used for cost estimates.
# AVAILABLE_MODELS are shown in the UI and used, in order, for automatic failover.
MODEL_FALLBACK=true
MODEL_PRICES=gemini-3.1-flash-lite=0.25/1.50;gemini-3.5-flash-lite=0.30/2.50;gemini-2.5-flash=0.30/2.50
