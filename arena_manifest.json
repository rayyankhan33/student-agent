{
  "arena_version": "0.1",
  "agent_name": "JobTracker",
  "domain": "Job-Application Tracker",
  "description": "Bounded agent that manages a sandbox job-application board: search, add, update status, detect duplicates, and summarise applications.",
  "endpoint": "/arena/run",
  "health_endpoint": "/health",
  "implementation": "complete",
  "tools": [
    "search_applications",
    "add_application",
    "update_status",
    "detect_duplicates",
    "get_summary"
  ],
  "fault_types": [
    "none",
    "tool_timeout",
    "malformed_tool_output",
    "invalid_agent_decision"
  ],
  "limits": {
    "max_steps": 6,
    "max_tool_retries": 2,
    "run_timeout_seconds": 40,
    "max_response_bytes": 50000
  }
}
